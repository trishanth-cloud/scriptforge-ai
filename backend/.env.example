# ScriptForge AI — Environment Configuration
# Copy this file to .env and fill in your values.

# REQUIRED: Your Google Gemini API key
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Debug mode (default: false)
DEBUG=true

# Active and supported Gemini model: gemini-3.5-flash-lite
# Fallback models: gemini-3.1-flash-lite, gemini-3.8-flash
AI_MODEL=gemini-3.5-flash-lite

# Optional: Script execution timeout in seconds (default: 30)
EXECUTION_TIMEOUT=30

# Optional: Max upload file size in bytes (default: 10485760 = 10MB)
MAX_FILE_SIZE=10485760
